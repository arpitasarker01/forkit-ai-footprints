{
  "hosting":{"public":"site","cleanUrls":true,"trailingSlash":false,
    "ignore":["firebase.json","**/.*","**/node_modules/**"],
    "headers":[
      {"source":"**","headers":[
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
        {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}
      ]},
      {"source":"**/*.@(css|js|svg)","headers":[{"key":"Cache-Control","value":"public,max-age=3600"}]}
    ],
    "redirects":[
      {"source":"/footprint","destination":"/footprint/","type":301},
      {"source":"/action-assurance","destination":"/action-assurance/","type":301},
      {"source":"/how-it-works","destination":"/how-it-works/","type":301},
      {"source":"/reconstruct","destination":"/reconstruct/","type":301},
      {"source":"/contact","destination":"/contact/","type":301}
    ]
  }
}